# ================================================================
# EduAI Governance Platform — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to git.
# ================================================================

# ── App ──────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ── Database (Supabase session-mode pooler) ───────────────────────
# Find in: Supabase dashboard → Project Settings → Database → Connection string
# Use port 5432 (session mode) NOT 6543 (transaction mode) for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ── Security ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app.com

# ── NVIDIA NIM (AI Tutor — primary LLM) ──────────────────────────
# Get at: https://integrate.api.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-CHANGE_ME
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# ── HuggingFace (AI Tutor — fallback LLM) ────────────────────────
# Get at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_CHANGE_ME
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── Google Gemini (concept image search) ─────────────────────────
GEMINI_API_KEY=AIza_CHANGE_ME

# ── Optional integrations (leave empty to disable) ───────────────
OPENAI_API_KEY=
SENTRY_DSN=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
