# ── Database (shared by EduSakhi + governance) ────────────────────────────────
# SQLite by default — no server needed. Switch to Postgres by changing this URL.
DATABASE_URL=sqlite:///./edusakhi.db

# ── Auth / JWT (governance) ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── EduSakhi AI ───────────────────────────────────────────────────────────────
HF_API_TOKEN=your_huggingface_api_token_here
HF_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DB_PATH=./chroma_db
UPLOAD_DIR=./uploads
