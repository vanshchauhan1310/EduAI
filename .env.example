# =============================================================
# EduAI Governance Platform — Environment Variables
# Copy this file to .env and fill in your actual values
# =============================================================

# ─── Application ─────────────────────────────────────────────
APP_NAME="EduAI Governance Platform"
APP_ENV=development                  # development | staging | production
APP_VERSION=1.0.0
DEBUG=true

# ─── Backend Server ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:19000,http://localhost:3000

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eduai_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Redis (Caching & Sessions) ───────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─── AI / ML ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.3
DROPOUT_PREDICTION_THRESHOLD=0.65
RISK_SCORE_LOW=30
RISK_SCORE_MEDIUM=60
RISK_SCORE_HIGH=80

# ─── Firebase (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ─── WhatsApp (Twilio / WATI) ────────────────────────────────
WHATSAPP_PROVIDER=twilio               # twilio | wati | meta
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WATI_API_ENDPOINT=https://live-server.wati.io
WATI_API_KEY=your-wati-api-key

# ─── SMS (optional fallback) ─────────────────────────────────
SMS_PROVIDER=twilio
TWILIO_SMS_NUMBER=+1xxxxxxxxxx

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@eduai-platform.com

# ─── AWS S3 (File Storage) ───────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=eduai-platform-files

# ─── Sentry (Error Monitoring) ───────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Mobile App (Expo) ───────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_NAME="EduAI Platform"
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development

# ─── Analytics ───────────────────────────────────────────────
ANALYTICS_ENABLED=true
MIXPANEL_TOKEN=your-mixpanel-token

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | text
