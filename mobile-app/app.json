{
  "expo": {
    "name": "EduAI Platform",
    "slug": "eduai-governance-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eduai.governance"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#1d4ed8"
      },
      "package": "com.eduai.governance",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      ["expo-notifications", { "icon": "./src/assets/notification-icon.png", "color": "#1d4ed8" }],
      ["expo-location", { "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for attendance geo-verification." }],
      ["expo-camera", { "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera." }]
    ],
    "scheme": "eduai",
    "extra": {
      "eas": { "projectId": "your-eas-project-id" }
    }
  }
}
