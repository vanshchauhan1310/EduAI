# Copy this file to ".env" in the prototype/ folder and fill in your token.

# ── HuggingFace (free) ────────────────────────────────────────────────────────
# Create a token (READ scope) at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any instruction-tuned chat model available on HF Inference.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── SQL storage ───────────────────────────────────────────────────────────────
# Default is a local SQLite file. Point at Postgres/MySQL to use a server DB.
PROTOTYPE_DB=sqlite:///./prototype.db
